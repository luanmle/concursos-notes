{
  "name": "@concursos-notes/note-actions",
  "version": "1.0.0",
  "description": "Botões de ação da nota: baixar .md, salvar PDF, tela cheia e editar no GitHub",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "note-actions",
    "displayName": "Note Actions",
    "category": ["component", "emitter"],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "repo": "luanmle/concursos-notes",
      "branch": "v5",
      "showDownloadMd": true,
      "showPdf": true,
      "showFullscreen": true,
      "showEdit": true
    },
    "components": {
      "NoteActions": {
        "displayName": "Note Actions",
        "defaultPosition": "beforeBody",
        "defaultPriority": 22
      }
    }
  }
}
