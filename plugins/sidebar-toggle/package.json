{
  "name": "@concursos-notes/sidebar-toggle",
  "version": "1.0.0",
  "description": "Botão para recolher/expandir a sidebar esquerda, com estado persistente",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "sidebar-toggle",
    "displayName": "Sidebar Toggle",
    "category": ["component"],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "SidebarToggle": {
        "displayName": "Sidebar Toggle",
        "defaultPosition": "left",
        "defaultPriority": 5
      }
    }
  }
}
