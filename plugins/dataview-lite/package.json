{
  "name": "@concursos-notes/dataview-lite",
  "version": "1.0.0",
  "description": "Renderiza um subconjunto de queries Dataview (TABLE/LIST, FROM, WHERE, SORT, GROUP BY) no site publicado",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "dataview-lite",
    "displayName": "Dataview Lite",
    "category": ["transformer", "component"],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 15,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "DataviewLite": {
        "displayName": "Dataview Lite Index",
        "defaultPosition": "beforeBody",
        "defaultPriority": 90
      }
    }
  }
}
